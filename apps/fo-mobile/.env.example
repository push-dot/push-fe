# Copy to .env.local. API_MOCK=1 serves fixtures from src/mock instead of push-be.
# `pnpm start` uses the production server; `pnpm start:test` overrides the API URL with the test server.
EXPO_PUBLIC_API_MOCK=0
EXPO_PUBLIC_API_BASE_URL=https://push-be.youngjoon568.workers.dev/api/v1
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5174
# Dev-only shortcut sign-in. Only the test server accepts it (its DEV_AUTH_TOKEN).
EXPO_PUBLIC_DEV_AUTH_TOKEN=
